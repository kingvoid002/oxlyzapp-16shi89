{
  "version": 2,
  "builds": [
    {
      "src": "api/*.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/search",
      "dest": "/api/search.py"
    },
    {
      "src": "/api/stream",
      "dest": "/api/stream.py"
    },
    {
      "src": "/api/playlist",
      "dest": "/api/playlist.js"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
